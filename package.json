{
  "name": "ferrari-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Ferrari Manager V1 : prise de commandes, suivi, fidélité et tickets pour la Pizzeria Ferrari (version de test, données fictives).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tablette": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:apercu": "tsc --noEmit && vite build --mode apercu --outDir dist-apercu",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
